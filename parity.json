  "classes": {
    "lone-surrogates": "Lone surrogate escapes in parsed JSON become U+FFFD; upstream keeps them until sanitizeSurrogates.",
    "input-limits": "Numbers outside the f64 range and nesting deeper than 128 levels are rejected; JSON.parse accepts them.",
    "key-order": "Session, RPC and config data are compared by value; object key order may differ where upstream order depends on assignment order.",
    "engine-error-text": "V8 JSON.parse error details are masked; the surrounding template is compared verbatim.",
    "wall-clock": "Values taken from the wall clock (Date.now) are masked; presence and type are compared.",
    "schema-formats": "Format checks use the jsonschema crate's implementations; the decision may differ from TypeBox on edge cases, messages match.",
    "sdk-headers": "Headers the upstream SDK injects (x-stainless-*) and the client identity User-Agent are not compared; only headers pi sets explicitly are."
  },

{
  "name": "@qntx/bot-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/bot.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp check && taplo fmt --check && bun scripts/check-version.ts && bun scripts/parity/check.ts && bun scripts/check-layers.ts",
    "typecheck": "vp run -r typecheck && tsc --noEmit",
    "build": "vp run -r build",
    "test": "vp run -r test && vp test",
    "dev": "bun run --cwd apps/desktop tauri dev",
    "bundle": "bun run --cwd apps/desktop tauri build",
    "release": "bumpp",
    "prepare": "vp config",
    "vectors": "node scripts/parity/generate-js-json.ts && node scripts/parity/generate-types.ts && node scripts/parity/generate-streaming-json.ts && node scripts/parity/generate-stream.ts && node scripts/parity/generate-transcript.ts && node scripts/parity/generate-ai-utils.ts && bun run scripts/parity/generate-schema.ts && bun run scripts/parity/generate-http-policy.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@taplo/cli": "0.7.0",
    "@types/node": "26.6.5",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
